# ProxPanel — copier vers .env et adapter
# cp .env.example .env
# https://github.com/sannier3/ProxPanel

# --- Application ---
NODE_ENV=development
PROD=false
DEBUG=false
PORT=8080
HOST=0.0.0.0
SESSION_SECRET=changez-moi-en-production-32-caracteres-min
COOKIE_SECURE=false

# --- Proxmox (mode production) ---
PROXMOX_URL=https://pve.example.com:8006
PROXMOX_ROOT_USER=root
PROXMOX_ROOT_PASSWORD=

# --- Collecteur (cache inventaire /cluster/resources) ---
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_MS=30000
MAX_PARALLEL_PVE=20

# --- Stats VM (status/current, périmètre restreint côté UI) ---
VMSTATS_MAX=80
VMSTATS_CACHE_TTL_MS=4000

# --- Temps réel (SSE) ---
REALTIME_ENABLED=true
REALTIME_STATS_MS=5000

# --- Workspace (fenêtres / vue persistés serveur) ---
WORKSPACE_DIR=./data/workspaces

# --- Modules Bash sur l'hôte Proxmox (sans SSH) ---
LOCAL_EXEC=false
MODULES_PATH=./modules

# --- Docker Compose (optionnel) ---
# PROXPANEL_IMAGE_TAG=alpha
# PROXPANEL_IMAGE_TAG=latest
